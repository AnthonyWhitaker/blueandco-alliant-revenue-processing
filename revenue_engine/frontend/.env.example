# Base URL for API calls. Leave empty to call the same origin (/api/...), which
# is how production is served and how the Vite dev proxy works. Anything set
# here is baked into the public bundle at build time: never put secrets here.
VITE_API_BASE_URL=

# Dev server only: where Vite proxies /api requests.
API_PROXY_TARGET=http://localhost:8000
