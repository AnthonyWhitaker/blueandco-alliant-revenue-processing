{
  "name": "revenue-engine-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "node scripts/generate-api-types.mjs && prettier --write src/api/schema.d.ts",
    "api:sync": "make -C .. openapi && npm run api:types",
    "ci": "npm run api:types && git diff --exit-code src/api/schema.d.ts && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "analyze": "ANALYZE=1 vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@mantine/core": "9.7.2",
    "@mantine/dropzone": "9.7.2",
    "@mantine/form": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@mantine/modals": "9.7.2",
    "@mantine/notifications": "9.7.2",
    "@mantine/nprogress": "9.7.2",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.2",
    "clsx": "^2.1.1",
    "mantine-datatable": "9.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "6.30.6",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tanstack/react-query-devtools": "5.104.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.30",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
